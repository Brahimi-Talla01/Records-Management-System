#  .gitignore racine - Monorepo (backend Python + frontend JS)

# Python / backend
venv/
**/venv/
env/
**/env/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/
backend/instance/
backend/.webassets-cache/

# Node / frontend
node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/.next/
frontend/.angular/
frontend/coverage/
frontend/*.local

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets & configuration locale
.env
.env.local
**/.env
**/.env.local
*.pem
*.key

# Bases de données locales
*.db
*.sqlite
*.sqlite3

# Uploads applicatifs
backend/uploads/
uploads/

# Tests E2E (Playwright)
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/e2e/.auth/

# IDE / Éditeurs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.iml

# OS
.DS_Store
Thumbs.db

# Outils
.freebuff

#  NB : les règles /backend/ et /frontend/ ont été RETIRÉES.
#  Elles bloquaient la version du code dans le monorepo fusionné.
