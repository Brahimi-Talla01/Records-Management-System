# ==============================================================================
# UniArchive — Backend : exemple de configuration
# Copier ce fichier en ".env" puis renseigner les valeurs réelles.
# NE JAMAIS COMMITTER le fichier .env (il est ignoré par backend/.gitignore).
# ==============================================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=changez-moi-avec-une-valeur-aleatoire-longue

# --- Base de données PostgreSQL ---
# Format : postgresql://utilisateur:mot_de_passe@hote:port/nom_base
DATABASE_URL=postgresql://user:password@localhost:5432/uniarchive

# --- Sessions opaques ---
# Cookie HTTPOnly portant l'ID de session ; CSRF en double-submit
SESSION_COOKIE_NAME=uniarchive_session
CSRF_COOKIE_NAME=uniarchive_csrf
CSRF_HEADER_NAME=X-CSRF-Token
# Durée de vie glissante de la session (7 jours par défaut)
SESSION_TTL_SECONDS=604800
# En production (HTTPS) : décommenter
# SESSION_COOKIE_SECURE=true
# Même domaine API/frontend recommandé ; sinon SameSite=None + Secure
SESSION_COOKIE_SAMESITE=Lax

# --- Redis (sessions + rate limiting) ---
# Optionnel en dev : fallback mémoire automatique si absent/indisponible
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# --- Bootstrap du super admin (12-factor) ---
# Utilisés par `flask seed admin|all` et par docker-entrypoint.sh au démarrage.
# En FLASK_ENV=production, ADMIN_PASSWORD est OBLIGATOIRE (repli refusé).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@uniarchive.edu
ADMIN_PASSWORD=changez-moi-mot-de-passe-admin
ADMIN_FULL_NAME=Administrateur Principal
ADMIN_MATRICULE=ADMIN001

# Jeu de données de démonstration (documents PDF, tags) — voir docker-compose.yml
# (variable lue par docker-entrypoint.sh ; en CLI : `flask seed demo-data`)
SEED_DEMO_DATA=false

# --- Email (SMTP) ---
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=contact@example.com
MAIL_PASSWORD=mot_de_passe_smtp

# --- Frontend (CORS + liens dans les emails) ---
FRONTEND_URL=http://localhost:5173
