# UniArchive — Configuration docker compose (racine)
# Copier en ".env" puis adapter. NE JAMAIS COMMITTER le fichier .env.

# Port d'accès à l'application
APP_PORT=8080

# URL d'API compilée dans le bundle frontend (au build).
# Valeur par défaut "/api" : URL relative → même origine, Nginx proxifie /api.
# Ne modifier que si le frontend est servi depuis un autre domaine que l'API.
VITE_API_URL=/api

# PostgreSQL
POSTGRES_DB=uniarchive
POSTGRES_USER=uniarchive
POSTGRES_PASSWORD=changez-moi-mot-de-passe-postgres

# Backend
# En production réelle : FLASK_ENV=production + SECRET_KEY aléatoire long
FLASK_ENV=production
SECRET_KEY=changez-moi-avec-une-valeur-aleatoire-longue
# Cookies : false en local HTTP, true derrière HTTPS
SESSION_COOKIE_SECURE=false
# Redirection HTTPS côté Flask (true uniquement derrière un terminateur TLS)
FORCE_HTTPS=false
GUNICORN_WORKERS=2

# --- Bootstrap du super admin (créé au démarrage du backend si absent) ---
# Identifiants définis ICI (12-factor) : changez-les avant tout déploiement.
# En FLASK_ENV=production, ADMIN_PASSWORD vide = conteneur qui refuse de démarrer.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@uniarchive.edu
ADMIN_PASSWORD=changez-moi-mot-de-passe-admin
ADMIN_FULL_NAME=Administrateur Principal
ADMIN_MATRICULE=ADMIN001

# Données de démonstration (6 documents PDF réels, étiquettes) — installer une
# seule fois sur une base vierge (docker compose down -v pour repartir de zéro).
# Laisser false en production.
SEED_DEMO_DATA=true

# SMTP (laisser vide en dev : code 2FA loggé dans les logs backend)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

FRONTEND_URL=http://localhost:8080
